{
  "name": "timelines",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Search spoken audio across open sources, preview clips, export samples. Desktop app and web app.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --env-file=.env --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file=.env server/index.ts",
    "ingest": "node --env-file=.env server/ingest.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"server/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "desktop": "npm run build && electron .",
    "desktop:fresh": "node scripts/ensure-electron.mjs && npm run build && TIMELINES_DATA=$(mktemp -d) electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "icon": "node scripts/make-icon.mjs",
    "predesktop": "node scripts/ensure-electron.mjs"
  },
  "dependencies": {
    "hyparquet": "^1.32.0",
    "hyparquet-compressors": "^1.1.2"
  },
  "devDependencies": {
    "@fontsource/space-mono": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "main": "desktop/main.mjs",
  "author": "davidnb3",
  "homepage": "https://github.com/davidnb3/timelines-sampler"
}
