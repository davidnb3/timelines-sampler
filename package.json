{
  "name": "telly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Search spoken audio and TV captions across open sources, preview clips, export samples.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --env-file=.env --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file=.env server/index.ts",
    "ingest": "node --env-file=.env server/ingest.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"server/**/*.test.ts\""
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
